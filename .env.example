# Local development only. Do not commit this file. Generate unique random values for each secret.
POSTGRES_PASSWORD=replace-with-a-random-local-admin-secret
POSTGRES_APP_PASSWORD=replace-with-a-different-random-app-secret
POSTGRES_MIGRATION_PASSWORD=replace-with-a-different-random-migration-secret
DB_URL=jdbc:postgresql://localhost:15432/peditto
DB_USER=peditto_app
DB_PASSWORD=replace-with-the-same-app-secret-as-POSTGRES_APP_PASSWORD
DB_MIGRATION_USER=peditto_migrator
DB_MIGRATION_PASSWORD=replace-with-the-same-migration-secret-as-POSTGRES_MIGRATION_PASSWORD
RATE_LIMIT_HMAC_KEY=replace-with-at-least-32-random-characters
OTP_HMAC_KEY=replace-with-a-distinct-random-secret-at-least-32-characters
OUTBOX_ENCRYPTION_KEY_BASE64=replace-with-base64-encoded-32-byte-key
OUTBOX_ENCRYPTION_KEY_VERSION=local-v1
OTP_DELIVERY_ENABLED=false
OTP_OUTBOX_POLL_MS=1000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
OTP_MAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=
